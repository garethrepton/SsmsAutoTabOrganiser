<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AutoTabOrganiser</RootNamespace>
    <AssemblyName>AutoTabOrganiser</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- DeployExtension auto-installs into a VS Experimental hive on F5; off here so headless
         Build-Tools-only machines just produce the .vsix (no IDE present to deploy into). -->
    <DeployExtension>false</DeployExtension>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>

    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.2178">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Imaging" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.ImageCatalog" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.522" />

    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="6.0.36" />
    <!-- 3.0.3 pulls SourceGear.sqlite3 3.50.4.5 = SQLite 3.50.4 (fixes CVE-2025-6965,
         present in the 3.49.1 that SQLitePCLRaw 2.1.11 shipped). In the 3.x line the
         native library comes from SourceGear.sqlite3 (versioned by SQLite version, not
         SQLitePCLRaw version). The IncludeSqliteNativeInVsix target below hardcodes that
         version in the native DLL path — keep them in lockstep or the VSIX silently
         ships the old native.
         Runtime note: the VSIX has never carried the managed SQLitePCLRaw assemblies —
         SSMS 22 supplies its own (3.0.2 + SQLite 3.50.4 under PublicAssemblies\SQLite)
         and its resolver binds them version-blind (the old 2.1.11-compiled refs already
         ran against SSMS's 3.0.x in production). This bump aligns our compile refs with
         the 3.x line SSMS actually loads; also smoke-tested standalone (FTS5/WAL harness,
         redirects disabled) in case SSMS's copies ever go away. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
    <!-- Compile-graph-only pin: the VS SDK's transitive MessagePack 2.2.85 carries
         CVE-2024-48924 (and 2.5.187 carries CVE-2026-48109/48506). Nothing here ships at
         runtime (SSMS supplies its own copies); this lifts the resolved version so
         vulnerability scans run clean. -->
    <PackageReference Include="MessagePack" Version="2.5.301" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="EnvDTE">
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <!-- For System.Windows.Forms.ColorDialog used by the tag colour configuration UI. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- For the Export-archive command (ZipFile / ZipArchive). -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Storage\Schema.sql">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SourceGear.sqlite3's props error on AnyCPU because the package can't pick a native
       architecture by itself. We pick win-x64 explicitly in IncludeSqliteNativeInVsix
       below (SSMS is 64-bit only), so neutralise the guard with an empty override. -->
  <Target Name="CheckForAnyCPU" />

  <Target Name="IncludeSqliteNativeInVsix" AfterTargets="ResolveAssemblyReferences" BeforeTargets="GetCopyToOutputDirectoryItems;BuiltProjectOutputGroup">
    <ItemGroup>
      <Content Include="$(NuGetPackageRoot)sourcegear.sqlite3\3.50.4.5\runtimes\win-x64\native\e_sqlite3.dll"
               Condition="Exists('$(NuGetPackageRoot)sourcegear.sqlite3\3.50.4.5\runtimes\win-x64\native\e_sqlite3.dll')">
        <Link>e_sqlite3.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Import Project="$(VsSDKInstall)\Microsoft.VsSDK.targets" Condition="'$(VsSDKInstall)' != ''" />

</Project>
