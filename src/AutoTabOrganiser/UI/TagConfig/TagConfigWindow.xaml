<Window x:Class="AutoTabOrganiser.UI.TagConfig.TagConfigWindow"
        x:Name="RootWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Tag Config"
        WindowStartupLocation="CenterOwner"
        Width="640" Height="600"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ====== COLOURS TAB ====== -->
            <TabItem Header="Colours">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8"
                               Text="Override the auto-derived colour for any tag. Cleared overrides fall back to the hash-based palette." TextWrapping="Wrap" />

                    <ListBox Grid.Row="1" x:Name="TagsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                                            Background="{Binding Swatch}" />

                                    <TextBlock Grid.Column="1" Text="{Binding Tag}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2" Text="{Binding HexLabel}" Opacity="0.7"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               FontFamily="Consolas" FontSize="11" />

                                    <Button Grid.Column="3" Content="Pick…" Margin="0,0,4,0"
                                            Click="OnPick_Click" Tag="{Binding}" />
                                    <Button Grid.Column="4" Content="Reset"
                                            Click="OnReset_Click" Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ====== RULES TAB ====== -->
            <TabItem Header="Auto-tag rules">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="When a Match substring (case-insensitive) is found anywhere in a tab's content, the listed tags are auto-applied. Tags are comma-separated, no leading #." />

                    <Grid Grid.Row="1" Margin="2,0,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Match (substring)" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="Tags (comma-separated)" FontWeight="SemiBold" Opacity="0.75" Margin="6,0,0,0" />
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="RulesList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,4,0"
                                             Text="{Binding Match, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Margin="2,0,4,0"
                                             Text="{Binding TagsCsv, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="✕" Click="OnRemoveRule_Click"
                                            Tag="{Binding}" MinWidth="0" Padding="8,2"
                                            ToolTip="Remove this rule" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Row="3" Margin="0,6,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="+ Add rule" Click="OnAddRule_Click" />
                    </DockPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Padding="14,3"
                    Margin="6,0,0,0" Click="OnOk_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="14,3"
                    Click="OnCancel_Click" />
        </DockPanel>
    </Grid>
</Window>
