<UserControl x:Class="AutoTabOrganiser.UI.Detail.DetailPane"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8" x:Name="RootPanel">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="BreadcrumbText" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
            <ItemsControl x:Name="TagChips" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,4,4"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.AccentLightBrushKey}}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.AccentBorderBrushKey}}">
                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ConnectionText" Margin="0,6,0,0" Opacity="0.7" />
            <TextBlock x:Name="LastSnapshotText" Margin="0,2,0,0" Opacity="0.7" />
            <FlowDocumentScrollViewer x:Name="MarkdownHost" Margin="0,8,0,0"
                                       Background="Transparent"
                                       VerticalScrollBarVisibility="Disabled" />
            <TextBlock x:Name="ErrorText" Foreground="OrangeRed" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
