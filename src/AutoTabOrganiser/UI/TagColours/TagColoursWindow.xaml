<Window x:Class="AutoTabOrganiser.UI.TagColours.TagColoursWindow"
        x:Name="RootWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Tag Colours"
        WindowStartupLocation="CenterOwner"
        Width="520" Height="540"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8"
                   Text="Override the auto-derived colour for any tag. Cleared overrides fall back to the hash-based palette." TextWrapping="Wrap" />

        <ListBox Grid.Row="1" x:Name="TagsList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                                Background="{Binding Swatch}" />

                        <TextBlock Grid.Column="1" Text="{Binding Tag}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding HexLabel}" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontFamily="Consolas" FontSize="11" />

                        <Button Grid.Column="3" Content="Pick…" Margin="0,0,4,0"
                                Click="OnPick_Click" Tag="{Binding}" />
                        <Button Grid.Column="4" Content="Reset"
                                Click="OnReset_Click" Tag="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Padding="14,3"
                    Margin="6,0,0,0" Click="OnOk_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="14,3"
                    Click="OnCancel_Click" />
        </DockPanel>
    </Grid>
</Window>
