<UserControl x:Class="AutoTabOrganiser.UI.ToolWindowControl"
             x:Name="RootControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:conv="clr-namespace:AutoTabOrganiser.UI.Converters"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>

        <conv:StringToImageMonikerConverter x:Key="StringToMoniker" />
        <conv:BoolToVisibilityConverter     x:Key="BoolToVis" />

        <!-- Section header style: small caps, muted, consistent letter-spacing. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <!-- Toggle button used inside the themed ComboBox template. -->
        <Style x:Key="ThemedComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Arrow" Grid.Column="1"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxMouseOverBackgroundBeginBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxMouseOverBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxMouseDownBackgroundBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ThemedComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,22,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBackgroundBeginBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBorderBrushKey}}"
                                            BorderThickness="1" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownTextBrushKey}}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMenuItemMouseOverBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMenuItemMouseOverTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
        <!-- Tight Expander style: zero outer margin, zero padding, smaller header font so each
             section header eats ~18px instead of the WPF default ~30px. This is the difference
             between four sections fitting comfortably above the fold and the user having to
             scroll to find the SEARCH box. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonHoverBrushKey}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:TreeViewColors.SelectedItemActiveBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        </Style>

        <!-- Reusable tag-chip template: small rounded pill, foreground auto-contrasted. -->
        <DataTemplate x:Key="TagChipTemplate">
            <Border Background="{Binding Brush}" CornerRadius="7" Padding="6,1"
                    Margin="0,0,4,0" SnapsToDevicePixels="True">
                <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Foreground}" />
            </Border>
        </DataTemplate>

        <!-- Clickable variant for the recent-tag chip strip at the top of the unified list.
             Active chips render at full opacity with a 2px accent ring; inactive chips dim
             so the eye picks out which filters are applied at a glance. -->
        <DataTemplate x:Key="TagFilterChipTemplate">
            <Button Command="{Binding ToggleCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    MinWidth="0" Margin="0,0,4,2"
                    Cursor="Hand"
                    ToolTip="Click to filter by this tag (click again to remove)">
                <Border x:Name="ChipBorder"
                        Background="{Binding Brush}" CornerRadius="8" Padding="7,2"
                        BorderThickness="2" BorderBrush="Transparent"
                        Opacity="0.55"
                        SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding Foreground}" />
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="ChipBorder" Property="Opacity" Value="1.0" />
                    <Setter TargetName="ChipBorder" Property="BorderBrush"
                            Value="{DynamicResource {x:Static vsui:EnvironmentColors.AccentMediumBrushKey}}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Shared two-line tab row: open-accent left border + bold title when open, status icons,
             title + subtitle, OPEN badge, tag chips, hover-only action. -->
        <DataTemplate x:Key="TabRowTemplate">
            <Border x:Name="RowOuter" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="6,0,0,0">
                <Grid Background="Transparent" ToolTip="{Binding TooltipText}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Ellipse Width="9" Height="9" Margin="0,0,4,0"
                                 Fill="#22C55E" Stroke="White" StrokeThickness="1"
                                 ToolTip="Open in editor"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                        <imaging:CrispImage Width="14" Height="14"
                                            Moniker="{Binding GitMonikerName, Converter={StaticResource StringToMoniker}}"
                                            ToolTip="{Binding GitTooltip}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- OPEN badge: small accent pill next to the title. Strong visual cue that
                         this tab is currently live in SSMS. -->
                    <Border Grid.Column="2" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static vsui:EnvironmentColors.AccentMediumBrushKey}}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="OPEN" FontSize="9" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <ItemsControl Grid.Column="3" VerticalAlignment="Center" Margin="6,0,0,0"
                                  ItemsSource="{Binding Tags}"
                                  ItemTemplate="{StaticResource TagChipTemplate}"
                                  Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Hover-only inline action: save to scripts. Visibility flips on row hover. -->
                    <Button Grid.Column="4" x:Name="HoverAction" Margin="6,0,0,0" MinWidth="0"
                            Padding="4,1" ToolTip="Save to scripts folder"
                            Command="{Binding DataContext.SaveToScriptsCommand, ElementName=RootControl}"
                            CommandParameter="{Binding}"
                            Visibility="Hidden">
                        <imaging:CrispImage Width="14" Height="14"
                                            Moniker="{x:Static catalog:KnownMonikers.SaveAs}" />
                    </Button>

                    <!-- Far-right timestamps: edited (any snapshot) on top, saved (saved-reason
                         snapshot) below. "saved" line hides when the tab has never been written
                         to disk via Save to scripts folder. -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding LastEditedText}" FontSize="10"
                                   Opacity="0.6" TextAlignment="Right" />
                        <TextBlock Text="{Binding LastSavedText}" FontSize="10"
                                   Opacity="0.6" TextAlignment="Right"
                                   Visibility="{Binding HasLastSaved, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="HoverAction" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="RowOuter" Property="BorderBrush"
                            Value="{DynamicResource {x:Static vsui:EnvironmentColors.AccentMediumBrushKey}}" />
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Context menu: relies on Tag on the ListBoxItem (set by ItemContainerWithMenu) to
             reach the root ToolWindowViewModel's commands. -->
        <ContextMenu x:Key="TabRowContextMenu">
            <MenuItem Header="Open"
                      Command="{Binding PlacementTarget.Tag.OpenTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Open in new query"
                      Command="{Binding PlacementTarget.Tag.OpenAsNewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Pin tag" x:Name="PinTagMenu" SubmenuOpened="OnPinTagSubmenuOpened" />
            <Separator />
            <MenuItem Header="Copy id"
                      Command="{Binding PlacementTarget.Tag.CopyIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Copy file path"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Reveal snapshot file"
                      Command="{Binding PlacementTarget.Tag.RevealSnapshotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Save to scripts folder…"
                      Command="{Binding PlacementTarget.Tag.SaveToScriptsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Git">
                <MenuItem Header="Add"
                          Command="{Binding PlacementTarget.Tag.GitAddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Commit (auto msg)"
                          Command="{Binding PlacementTarget.Tag.GitCommitAutoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Commit…"
                          Command="{Binding PlacementTarget.Tag.GitCommitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Status"
                          Command="{Binding PlacementTarget.Tag.GitStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete from history…"
                      Command="{Binding PlacementTarget.Tag.DeleteTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <Style x:Key="ItemContainerWithMenu" TargetType="ListBoxItem">
            <!-- Tag points at the root VM so the ContextMenu can reach its commands. -->
            <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootControl}" />
            <Setter Property="ContextMenu" Value="{StaticResource TabRowContextMenu}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </UserControl.Resources>

    <!--
        Grid rows (top → bottom):
          0  toolbar (compact icon strip)
          1  inline info bar (visibility-driven)
          2  scroll viewer containing RECENT (blended search) / Stored Queries / Pinned
          3  grid splitter (drag to resize detail pane)
          4  detail pane
          5  save-to-scripts inline prompt (visibility-driven)
        The old "Snapshots: {path}" footer (formerly row 6) has been removed — the toolbar
        already exposes "Open snapshot storage folder", and the path itself was 28px of
        always-on chrome that no user needs to see continuously.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: top-of-sidebar global commands. Replaces the Tools-menu entries that
             previously hosted these. Buttons stay reasonably small so they don't dominate
             the sidebar. Two-column grid: command buttons on the left, last-snapshot
             indicator right-aligned so the user can see at a glance when the safety-net
             last fired. -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,0,0,1" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Snapshot the active tab now (Ctrl+Alt+H, S)"
                        Command="{Binding SnapshotNowCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.TakeSnapshot}" />
                </Button>
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Quick switcher (Ctrl+T — forced override even if the chord overlaps an existing binding; Ctrl+Alt+H,O fallback; Ctrl+Alt+O / Ctrl+Shift+T also bound)"
                        Command="{Binding QuickSwitcherCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.GoToNext}" />
                </Button>
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Tag config (colours and auto-tag rules)"
                        Command="{Binding TagConfigCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.EditTag}" />
                </Button>
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Open settings.json"
                        Command="{Binding OpenSettingsCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.SettingsFile}" />
                </Button>
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Open config folder (containing settings.json and logs)"
                        Command="{Binding OpenConfigFolderCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.FolderClosed}" />
                </Button>
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Open snapshot storage folder (where every captured .sql lives)"
                        Command="{Binding OpenStorageCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.OpenFolder}" />
                </Button>
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Export everything (snapshot index + all .sql snapshots + settings) to a portable zip"
                        Command="{Binding ExportArchiveCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.Export}" />
                </Button>
                <!-- Pin tag lives in the toolbar (instead of its own row below) so the pinned-
                     sections list comes flush against the Stored Queries section — saves a row
                     of vertical space when no tags are pinned, and stays discoverable. -->
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Pin one or more tags as quick-access sections"
                        Command="{Binding PinNewTagCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.Tag}" />
                </Button>
                <!-- Vertical separator before the "New View" action so the multi-instance command
                     reads as a meta-action distinct from the per-window commands above. -->
                <Border Width="1" Margin="4,2" Background="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
                <Button Margin="0,0,2,0" Padding="6,3" MinWidth="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Open a new Tab Organiser window (another view of the same history — useful for side-by-side filters or tag pins)"
                        Command="{Binding NewViewCommand}">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.NewWindow}" />
                </Button>
            </StackPanel>

                <!-- Last-snapshot indicator. Updates on every snapshot (RefreshRecent fires
                     UpdateLastSnapshotFromRecent) and self-ticks once a second so the
                     relative text stays current between snapshots. Vertical-bar divider
                     matches the one before the "New View" button above. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="0,0,4,0">
                    <Border Width="1" Margin="4,2"
                            Background="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
                    <TextBlock Text="{Binding LastSnapshotText}"
                               ToolTip="{Binding LastSnapshotTooltip}"
                               FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                    <Border Width="1" Margin="4,2"
                            Background="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
                    <!-- Trust-made-visible: when the safety-net backup last fired. -->
                    <TextBlock Text="{Binding LastBackupText}"
                               ToolTip="{Binding LastBackupTooltip}"
                               FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inline info bar + session-restore banner (stacked; each visibility-driven). -->
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                    BorderThickness="0,0,0,1" Padding="8,4"
                    Visibility="{Binding InfoBarVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕"
                            MinWidth="0" Padding="4,0" Margin="6,0,0,0"
                            Command="{Binding CloseInfoBarCommand}"
                            Background="Transparent" BorderThickness="0" />
                    <TextBlock Text="{Binding InfoMessage}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                </DockPanel>
            </Border>

            <!-- Session restore: one-click reopen of everything the last session had open.
                 Shown once per SSMS launch when the previous session left open tabs behind
                 (crash or normal exit — snapshots survive both). -->
            <Border Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                    BorderThickness="0,0,0,1" Padding="8,4"
                    Visibility="{Binding SessionRestoreVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕"
                            MinWidth="0" Padding="4,0" Margin="6,0,0,0"
                            Command="{Binding DismissSessionRestoreCommand}"
                            ToolTip="Dismiss (the tabs stay in RECENT either way)"
                            Background="Transparent" BorderThickness="0" />
                    <Button DockPanel.Dock="Right" Content="Reopen all"
                            Padding="8,1" Margin="6,0,0,0"
                            Command="{Binding RestoreSessionCommand}"
                            ToolTip="Reopen every tab from the last session, including unsaved content captured by snapshots" />
                    <TextBlock Text="{Binding SessionRestoreText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Unified RECENT + SEARCH section. Empty search box shows the recent tabs
                     verbatim; typing flips the list to filtered search results. The chip
                     strip above the search box surfaces tags drawn from the last ~50 opens
                     so the user can one-click filter by any of them. -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="RECENT" Style="{StaticResource SectionHeader}" />
                    </Expander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tag chip strip. WrapPanel so chips flow onto multiple lines if
                             there are many; hidden entirely when no recent tags exist. -->
                        <ItemsControl Grid.Row="0" Margin="6,6,6,0"
                                      ItemsSource="{Binding RecentTagChips}"
                                      ItemTemplate="{StaticResource TagFilterChipTemplate}"
                                      Visibility="{Binding HasRecentTagChips, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Search box + sort dropdown, promoted to the top of the section.
                             Empty box ⇒ list shows Recent. Typing ⇒ list shows search results. -->
                        <Grid Grid.Row="1" Margin="6,6,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <imaging:CrispImage Grid.Column="0" Width="14" Height="14"
                                                        Margin="6,0,4,0" Opacity="0.6"
                                                        VerticalAlignment="Center"
                                                        Moniker="{x:Static catalog:KnownMonikers.Search}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             KeyDown="OnSearchBox_KeyDown"
                                             ToolTip="Empty = recent. Type to search: foo, name:foo, #tag, folder:x, desc:y, since:7d, server:x, db:x, -#archive (Esc to clear)" />
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearSearchCommand}"
                                            Visibility="{Binding ShowSearchClear, Converter={StaticResource BoolToVis}}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4,0" MinWidth="0" ToolTip="Clear search">
                                        <imaging:CrispImage Width="12" Height="12" Opacity="0.7"
                                                            Moniker="{x:Static catalog:KnownMonikers.Cancel}" />
                                    </Button>
                                    <!-- Search-syntax help. Clicking opens a popover (below) anchored
                                         to this button; Esc / click-outside dismisses. -->
                                    <Button Grid.Column="3" x:Name="SearchHelpButton"
                                            Click="OnSearchHelp_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4,0" MinWidth="0" ToolTip="Search syntax help">
                                        <imaging:CrispImage Width="12" Height="12" Opacity="0.7"
                                                            Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" />
                                    </Button>
                                    <Popup x:Name="SearchHelpPopup" Grid.Column="3"
                                           PlacementTarget="{Binding ElementName=SearchHelpButton}"
                                           Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Width="280"
                                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBackgroundBeginBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBorderBrushKey}}"
                                                BorderThickness="1" Padding="10,8"
                                                KeyDown="OnSearchHelpPopup_KeyDown">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,6"
                                                           Text="Search syntax" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="foo" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Plain text — name / desc / content" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="name:foo" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Restrict to tab name" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="#tag" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Has tag (e.g. #wip)" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="-#tag" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Does NOT have tag (e.g. -#archive)" />

                                                    <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="folder:x" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Folder match (e.g. folder:reports)" />

                                                    <TextBlock Grid.Row="5" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="desc:y" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Description text (e.g. desc:bug)" />

                                                    <TextBlock Grid.Row="6" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="since:7d" />
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Modified in last N days" />

                                                    <TextBlock Grid.Row="7" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="server:x" />
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Connection server (e.g. server:PRD01)" />

                                                    <TextBlock Grid.Row="8" Grid.Column="0" FontFamily="Consolas"
                                                               Margin="0,1,8,1" Text="db:x" />
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Opacity="0.8"
                                                               Margin="0,1,0,1"
                                                               Text="Connection database (e.g. db:Sales)" />
                                                </Grid>
                                                <TextBlock Margin="0,8,0,0" Opacity="0.6" FontSize="11"
                                                           Text="Esc clears the search box." />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="1" Margin="6,0,0,0" Width="140"
                                      SelectedValue="{Binding SortMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="Sort order (applies when searching)">
                                <ComboBoxItem Tag="recent"      Content="Most recent first" />
                                <ComboBoxItem Tag="name-asc"    Content="Name (A-Z)" />
                                <ComboBoxItem Tag="name-desc"   Content="Name (Z-A)" />
                                <ComboBoxItem Tag="folder-name" Content="Folder, then name" />
                            </ComboBox>
                        </Grid>

                        <!-- Single ListBox whose ItemsSource swaps based on SearchText state.
                             Recent when empty, filtered Tabs when non-empty. -->
                        <ListBox x:Name="RecentList" Grid.Row="2" MinHeight="160" MaxHeight="320"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding DisplayedItems}"
                                 ItemTemplate="{StaticResource TabRowTemplate}"
                                 ItemContainerStyle="{StaticResource ItemContainerWithMenu}"
                                 MouseDoubleClick="OnList_MouseDoubleClick"
                                 SelectionChanged="OnList_SelectionChanged" />

                        <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Margin="10,8"
                                   Text="{Binding ListEmptyText}"
                                   Visibility="{Binding ListEmptyVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Expander>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StoredQueriesHeader}" Style="{StaticResource SectionHeader}" />
                            <!-- Branch + ahead/behind for the stored-queries repo, e.g. "main ↑2". -->
                            <TextBlock Text="{Binding StoredQueriesBranchText}" Margin="8,0,0,0"
                                       Style="{StaticResource SectionHeader}" Opacity="0.55"
                                       Visibility="{Binding StoredQueriesPushVisible, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Commit message (Ctrl+Enter to commit all)"
                                     KeyDown="OnCommitMessage_KeyDown" />
                            <Button Grid.Column="1" Margin="6,0,0,0"
                                    ToolTip="git add + commit all changes in this section"
                                    Command="{Binding CommitAllStoredQueriesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Width="14" Height="14"
                                                        Moniker="{x:Static catalog:KnownMonikers.StatusOK}"
                                                        Margin="0,0,4,0" />
                                    <TextBlock Text="Commit All" />
                                </StackPanel>
                            </Button>
                            <!-- Push: the ONLY action in the extension that can touch the
                                 network, and only because it runs the user's own `git push`
                                 against their configured remote. Never automatic. -->
                            <Button Grid.Column="2" Margin="4,0,0,0" MinWidth="0" Padding="4,2"
                                    ToolTip="git push (sends commits to YOUR configured remote — never runs automatically)"
                                    Command="{Binding PushStoredQueriesCommand}"
                                    Visibility="{Binding StoredQueriesPushVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Push ↑" />
                            </Button>
                            <!-- Icon-only Open + Terminal: text labels are redundant with the
                                 tooltip and ate ~80px of horizontal space that the commit
                                 message box can now use instead. -->
                            <Button Grid.Column="3" Margin="4,0,0,0" MinWidth="0" Padding="4,2"
                                    ToolTip="Open the Stored Queries folder in Explorer"
                                    Command="{Binding OpenStoredQueriesFolderCommand}">
                                <imaging:CrispImage Width="14" Height="14"
                                                    Moniker="{x:Static catalog:KnownMonikers.OpenFolder}" />
                            </Button>
                            <Button Grid.Column="4" Margin="4,0,0,0" MinWidth="0" Padding="4,2"
                                    ToolTip="Open a terminal in the Stored Queries folder (Windows Terminal if available, else PowerShell)"
                                    Command="{Binding OpenStoredQueriesTerminalCommand}">
                                <imaging:CrispImage Width="14" Height="14"
                                                    Moniker="{x:Static catalog:KnownMonikers.Console}" />
                            </Button>
                        </Grid>
                        <TextBlock Margin="10,4,8,4" Style="{StaticResource MutedText}" Text="No changes."
                                   Visibility="{Binding StoredQueriesEmptyVisible, Converter={StaticResource BoolToVis}}" />
                        <ListBox x:Name="StoredQueriesList" BorderThickness="0" MaxHeight="240"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding StoredQueries}"
                                 MouseDoubleClick="OnStoredQueries_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding FilePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Letter}"
                                                   Foreground="{Binding LetterBrush}"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   Width="18" TextAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="{Binding StatusName}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding FileName}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding LastEditedText}" FontSize="10"
                                                       Opacity="0.6" TextAlignment="Right" />
                                            <TextBlock Text="{Binding LastSavedText}" FontSize="10"
                                                       Opacity="0.6" TextAlignment="Right"
                                                       Visibility="{Binding HasLastSaved, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <!-- Always visible. Hover-only buttons are clickable
                                             only while the row's IsMouseOver trigger is true,
                                             which flickers during repaints (especially when
                                             the collection is being refreshed). Clicks
                                             landing in that window were silently lost. -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.DiffStoredQueryCommand, ElementName=RootControl}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,1" MinWidth="0" Margin="4,0,0,0"
                                                    ToolTip="Show git diff">
                                                <imaging:CrispImage Width="14" Height="14"
                                                                    Moniker="{x:Static catalog:KnownMonikers.CompareFiles}" />
                                            </Button>
                                            <Button Command="{Binding DataContext.StageStoredQueryCommand, ElementName=RootControl}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,1" MinWidth="0" Margin="4,0,0,0"
                                                    ToolTip="Stage (git add)">
                                                <imaging:CrispImage Width="14" Height="14"
                                                                    Moniker="{x:Static catalog:KnownMonikers.PendingAddNode}" />
                                            </Button>
                                            <Button Command="{Binding DataContext.CommitStoredQueryCommand, ElementName=RootControl}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,1" MinWidth="0" Margin="4,0,0,0"
                                                    ToolTip="Commit this file (auto message)">
                                                <imaging:CrispImage Width="14" Height="14"
                                                                    Moniker="{x:Static catalog:KnownMonikers.StatusOK}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootControl}" />
                                    <Setter Property="ContextMenu" Value="{StaticResource TabRowContextMenu}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Expander>

                <!-- Pinned tag sections, bound to VM.PinnedSections. Pin-tag action lives in the
                     toolbar at the top — no separate button row here to keep the sidebar dense. -->
                <ItemsControl ItemsSource="{Binding PinnedSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Margin="4,2,4,2">
                                <Expander.Header>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left" />
                                        <Button DockPanel.Dock="Right" Content="✕"
                                                Padding="4,0" Margin="8,0,0,0" MinWidth="0"
                                                Command="{Binding UnpinCommand}"
                                                ToolTip="Unpin" />
                                    </DockPanel>
                                </Expander.Header>
                                <ListBox Margin="8,4,8,4" MaxHeight="240" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Items}"
                                         ItemTemplate="{StaticResource TabRowTemplate}"
                                         ItemContainerStyle="{StaticResource ItemContainerWithMenu}"
                                         MouseDoubleClick="OnList_MouseDoubleClick"
                                         SelectionChanged="OnList_SelectionChanged" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <ContentControl x:Name="DetailHost" />
        </Border>

        <!-- Inline name prompt for the "Save to scripts folder" action. -->
        <Border Grid.Row="5"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                Visibility="{Binding SavePromptVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Save to stored queries folder" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subfolder:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1"
                              IsEditable="True" IsTextSearchEnabled="False"
                              ItemsSource="{Binding SaveSubfolderItems}"
                              Text="{Binding SaveSubfolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Optional subfolder (e.g. Investigations/PROD-1234). Leave blank for the root." />
                    <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding BrowseSaveFolderCommand}"
                            ToolTip="Pick or create a subfolder via Explorer dialog" />
                </Grid>
                <TextBox Grid.Row="2" x:Name="SaveNameBox" Margin="0,4,0,4"
                         Text="{Binding SaveFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSaveNameBox_KeyDown" />
                <DockPanel Grid.Row="3" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0"
                            IsDefault="True"
                            Command="{Binding ConfirmSaveScriptsCommand}" />
                    <Button DockPanel.Dock="Right" Content="Cancel" Padding="10,2"
                            IsCancel="True"
                            Command="{Binding CancelSaveScriptsCommand}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}"
                               Text="{Binding SavePromptHint}" />
                </DockPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
