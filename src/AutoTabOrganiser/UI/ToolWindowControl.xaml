<UserControl x:Class="AutoTabOrganiser.UI.ToolWindowControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:conv="clr-namespace:AutoTabOrganiser.UI.Converters"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>

        <conv:StringToImageMonikerConverter x:Key="StringToMoniker" />
        <conv:BoolToVisibilityConverter     x:Key="BoolToVis" />

        <!-- Section header style: small caps, muted, consistent letter-spacing. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <!-- Toggle button used inside the themed ComboBox template. -->
        <Style x:Key="ThemedComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Arrow" Grid.Column="1"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxMouseOverBackgroundBeginBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxMouseOverBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxMouseDownBackgroundBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ThemedComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,22,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBackgroundBeginBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownPopupBorderBrushKey}}"
                                            BorderThickness="1" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.DropDownTextBrushKey}}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMenuItemMouseOverBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMenuItemMouseOverTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonHoverBrushKey}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:TreeViewColors.SelectedItemActiveBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        </Style>

        <!-- Reusable tag-chip template: small rounded pill, foreground auto-contrasted. -->
        <DataTemplate x:Key="TagChipTemplate">
            <Border Background="{Binding Brush}" CornerRadius="7" Padding="6,1"
                    Margin="0,0,4,0" SnapsToDevicePixels="True">
                <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Foreground}" />
            </Border>
        </DataTemplate>

        <!-- Shared two-line tab row: status icons | title + subtitle | tag chips | hover-only action. -->
        <DataTemplate x:Key="TabRowTemplate">
            <Grid Background="Transparent" ToolTip="{Binding TooltipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status icon column: open dot + git status icon. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Ellipse Width="6" Height="6" Margin="0,0,4,0"
                             Fill="{DynamicResource {x:Static vsui:EnvironmentColors.AccentMediumBrushKey}}"
                             ToolTip="Open in editor"
                             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                    <imaging:CrispImage Width="14" Height="14"
                                        Moniker="{Binding GitMonikerName, Converter={StaticResource StringToMoniker}}"
                                        ToolTip="{Binding GitTooltip}" />
                </StackPanel>

                <!-- Title + subtitle (folder path), stacked. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Tag chips, right-aligned. -->
                <ItemsControl Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                              ItemsSource="{Binding Tags}"
                              ItemTemplate="{StaticResource TagChipTemplate}"
                              Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Hover-only inline action: save to scripts. Visibility flips on row hover. -->
                <Button Grid.Column="3" x:Name="HoverAction" Margin="6,0,0,0" MinWidth="0"
                        Padding="4,1" ToolTip="Save to scripts folder"
                        Click="OnSaveToScripts_Click" Tag="{Binding}"
                        Visibility="Hidden">
                    <imaging:CrispImage Width="14" Height="14"
                                        Moniker="{x:Static catalog:KnownMonikers.SaveAs}" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="HoverAction" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="TabRowContextMenu">
            <MenuItem Header="Open"                  Click="OnCtx_Open" />
            <MenuItem Header="Open in new query"     Click="OnCtx_OpenAsNew" />
            <Separator />
            <MenuItem Header="Pin tag"               x:Name="PinTagMenu" SubmenuOpened="OnCtx_PinTagOpened" />
            <Separator />
            <MenuItem Header="Copy id"               Click="OnCtx_CopyId" />
            <MenuItem Header="Copy file path"        Click="OnCtx_CopyPath" />
            <MenuItem Header="Reveal snapshot file"  Click="OnCtx_RevealSnapshot" />
            <Separator />
            <MenuItem Header="Save to scripts folder…" Click="OnCtx_SaveToScripts" />
            <Separator />
            <MenuItem Header="Git" x:Name="GitMenu">
                <MenuItem Header="Add"               Click="OnCtx_GitAdd" />
                <MenuItem Header="Commit (auto msg)" Click="OnCtx_GitCommitAuto" />
                <MenuItem Header="Commit…"           Click="OnCtx_GitCommit" />
                <MenuItem Header="Status"            Click="OnCtx_GitStatus" />
            </MenuItem>
        </ContextMenu>

        <Style x:Key="ItemContainerWithMenu" TargetType="ListBoxItem">
            <Setter Property="ContextMenu" Value="{StaticResource TabRowContextMenu}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Inline info bar: shown via ShowInfo / hidden by close button. -->
        <Border Grid.Row="0" x:Name="InfoBar" Visibility="Collapsed"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="InfoBarClose" Content="✕"
                        MinWidth="0" Padding="4,0" Margin="6,0,0,0"
                        Click="OnInfoBarClose_Click"
                        Background="Transparent" BorderThickness="0" />
                <TextBlock x:Name="InfoBarText" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Expander IsExpanded="True" x:Name="RecentExpander">
                    <Expander.Header>
                        <TextBlock Text="RECENT" Style="{StaticResource SectionHeader}" />
                    </Expander.Header>
                    <Grid>
                        <ListBox x:Name="RecentList" BorderThickness="0" MaxHeight="240"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource TabRowTemplate}"
                                 ItemContainerStyle="{StaticResource ItemContainerWithMenu}" />
                        <TextBlock x:Name="RecentEmpty" Style="{StaticResource MutedText}"
                                   Margin="10,8" Text="No recent tabs yet — open a query."
                                   Visibility="Collapsed" />
                    </Grid>
                </Expander>

                <Expander IsExpanded="True" x:Name="SnippetsExpander">
                    <Expander.Header>
                        <TextBlock x:Name="SnippetsHeaderText" Text="SOURCE CONTROL — SNIPPETS"
                                   Style="{StaticResource SectionHeader}" />
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommitMessageBox" Grid.Column="0"
                                     ToolTip="Commit message (Ctrl+Enter to commit all)"
                                     KeyDown="OnCommitMessage_KeyDown" />
                            <Button x:Name="CommitAllBtn" Grid.Column="1" Margin="6,0,0,0"
                                    ToolTip="git add + commit all changes in this section"
                                    Click="OnCommitAllSnippets_Click">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Width="14" Height="14"
                                                        Moniker="{x:Static catalog:KnownMonikers.StatusOK}"
                                                        Margin="0,0,4,0" />
                                    <TextBlock Text="Commit All" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SnippetsEmptyHint" Margin="10,4,8,4" Style="{StaticResource MutedText}"
                                   Text="No changes." Visibility="Collapsed" />
                        <ListBox x:Name="SnippetsList" BorderThickness="0" MaxHeight="240"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="OnSnippetsDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding FilePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Letter}"
                                                   Foreground="{Binding LetterBrush}"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   Width="18" TextAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="{Binding StatusName}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding FileName}" />
                                        <StackPanel Grid.Column="2" x:Name="SnippetActions"
                                                    Orientation="Horizontal" Visibility="Hidden">
                                            <Button Click="OnStageSnippet_Click" Tag="{Binding}"
                                                    Padding="4,1" MinWidth="0" Margin="4,0,0,0"
                                                    ToolTip="Stage (git add)">
                                                <imaging:CrispImage Width="14" Height="14"
                                                                    Moniker="{x:Static catalog:KnownMonikers.PendingAddNode}" />
                                            </Button>
                                            <Button Click="OnCommitSnippet_Click" Tag="{Binding}"
                                                    Padding="4,1" MinWidth="0" Margin="4,0,0,0"
                                                    ToolTip="Commit this file (auto message)">
                                                <imaging:CrispImage Width="14" Height="14"
                                                                    Moniker="{x:Static catalog:KnownMonikers.StatusOK}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="SnippetActions" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="ContextMenu" Value="{StaticResource TabRowContextMenu}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="8,2,8,4">
                    <Button x:Name="PinNewTagBtn" Padding="6,1" Margin="0,0,4,0" MinWidth="0"
                            Click="OnPinNewTag_Click" ToolTip="Pin one or more tags as quick-access sections">
                        <StackPanel Orientation="Horizontal">
                            <imaging:CrispImage Width="14" Height="14"
                                                Moniker="{x:Static catalog:KnownMonikers.Tag}"
                                                Margin="0,0,4,0" />
                            <TextBlock Text="Pin tag" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="PinnedSectionsHost" />

                <Expander IsExpanded="True" x:Name="SearchExpander">
                    <Expander.Header>
                        <TextBlock Text="SEARCH" Style="{StaticResource SectionHeader}" />
                    </Expander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="6,6,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search field with an inline icon prefix; uses a Border so the icon
                                 sits inside the same chrome as the input. -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <imaging:CrispImage Grid.Column="0" Width="14" Height="14"
                                                        Margin="6,0,4,0" Opacity="0.6"
                                                        VerticalAlignment="Center"
                                                        Moniker="{x:Static catalog:KnownMonikers.Search}" />
                                    <TextBox x:Name="SearchBox" Grid.Column="1"
                                             BorderThickness="0" Background="Transparent"
                                             KeyDown="OnSearchBox_KeyDown"
                                             ToolTip="search: foo, name:foo, #tag, folder:x, desc:y, since:7d, -#archive (Esc to clear)" />
                                    <Button Grid.Column="2" x:Name="SearchClearBtn"
                                            Click="OnSearchClear_Click" Visibility="Collapsed"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4,0" MinWidth="0" ToolTip="Clear search">
                                        <imaging:CrispImage Width="12" Height="12" Opacity="0.7"
                                                            Moniker="{x:Static catalog:KnownMonikers.Cancel}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ComboBox x:Name="SortModeBox" Grid.Column="1" Margin="6,0,0,0" Width="140"
                                      ToolTip="Sort order">
                                <ComboBoxItem Tag="recent"      Content="Most recent first" IsSelected="True" />
                                <ComboBoxItem Tag="name-asc"    Content="Name (A-Z)" />
                                <ComboBoxItem Tag="name-desc"   Content="Name (Z-A)" />
                                <ComboBoxItem Tag="folder-name" Content="Folder, then name" />
                            </ComboBox>
                            <Button x:Name="GearButton" Grid.Column="2" Margin="6,0,0,0"
                                    ToolTip="Settings" Padding="4,1" MinWidth="0">
                                <imaging:CrispImage Width="14" Height="14"
                                                    Moniker="{x:Static catalog:KnownMonikers.Settings}" />
                            </Button>
                        </Grid>

                        <ListBox x:Name="TabsList" Grid.Row="1" MinHeight="160"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource TabRowTemplate}"
                                 ItemContainerStyle="{StaticResource ItemContainerWithMenu}" />

                        <TextBlock Grid.Row="2" x:Name="TabsEmpty" Style="{StaticResource MutedText}"
                                   Margin="10,8" Visibility="Collapsed"
                                   Text="No tabs match. Try clearing the search." />
                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <ContentControl x:Name="DetailHost" />
        </Border>

        <!-- Inline name prompt: replaces modal "Save to scripts folder" dialog. Shown via
             ShowSavePrompt and dismissed with Save/Cancel. -->
        <Border Grid.Row="4" x:Name="SavePrompt" Visibility="Collapsed"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Save to scripts folder" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subfolder:" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <!-- IsTextSearchEnabled keeps the typed prefix from jumping to a list item unintentionally. -->
                    <ComboBox x:Name="SaveSubfolderBox" Grid.Column="1"
                              IsEditable="True" IsTextSearchEnabled="False"
                              ToolTip="Optional subfolder (e.g. Investigations/PROD-1234). Leave blank for the root." />
                </Grid>
                <TextBox Grid.Row="2" x:Name="SaveNameBox" Margin="0,4,0,4"
                         KeyDown="OnSaveNameBox_KeyDown" />
                <DockPanel Grid.Row="3" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0"
                            IsDefault="True" Click="OnSavePromptOk_Click" />
                    <Button DockPanel.Dock="Right" Content="Cancel" Padding="10,2"
                            IsCancel="True" Click="OnSavePromptCancel_Click" />
                    <TextBlock x:Name="SavePromptHint" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Text="Will overwrite an existing file with the same name." />
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}">
            <DockPanel LastChildFill="True" Margin="6,3">
                <Button x:Name="OpenStorageBtn" DockPanel.Dock="Right" Content="Open" Padding="8,1" Margin="6,0,0,0"
                        ToolTip="Open snapshot folder in Explorer" Click="OnOpenStorage_Click" />
                <TextBlock x:Name="StoragePathLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Cursor="Hand" ToolTip="Click to open in Explorer"
                           MouseLeftButtonUp="OnOpenStorage_Click">
                    <Run Text="Snapshots: " />
                    <Run x:Name="StoragePathText" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
